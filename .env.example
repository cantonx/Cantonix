# ─── Network ──────────────────────────────────────────────────────────────
NETWORK=devnet
# devnet | testnet | mainnet

# ─── Provider ─────────────────────────────────────────────────────────────
PROVIDER=mock
# mock  → simulated data, no Canton nodes needed
# canton → connects to real Canton LocalNet nodes

# ─── Auth ─────────────────────────────────────────────────────────────────
AUTH_MODE=shared-secret
# shared-secret | oauth2

# ─── Keycloak (OAuth2) ────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak.localhost:8082
KEYCLOAK_APP_USER_REALM=AppUser
KEYCLOAK_APP_PROVIDER_REALM=AppProvider
KEYCLOAK_APP_USER_CLIENT_ID=app-user-validator
KEYCLOAK_APP_USER_CLIENT_SECRET=your-app-user-client-secret
KEYCLOAK_APP_PROVIDER_CLIENT_ID=app-provider-validator
KEYCLOAK_APP_PROVIDER_CLIENT_SECRET=your-app-provider-client-secret

# ─── Validator API (readyz — health checks) ───────────────────────────────
# Ports: x903
APP_USER_VALIDATOR_URL=http://localhost:2903/api/validator/readyz
APP_PROVIDER_VALIDATOR_URL=http://localhost:3903/api/validator/readyz
SUPER_VALIDATOR_URL=http://localhost:4903/api/validator/readyz

# Primary validator for onboarding / wallet ops
VALIDATOR_URI=http://localhost:3903/api/validator

# ─── JSON Ledger API (Daml ops, parties, DARs) ───────────────────────────
# Ports: x975
APP_USER_JSON_API_URL=http://localhost:2975
APP_PROVIDER_JSON_API_URL=http://localhost:3975
SUPER_JSON_API_URL=http://localhost:4975

# ─── Ledger API (gRPC) ────────────────────────────────────────────────────
# Ports: x901
APP_USER_LEDGER_HOST=localhost
APP_USER_LEDGER_PORT=2901
APP_PROVIDER_LEDGER_HOST=localhost
APP_PROVIDER_LEDGER_PORT=3901
SUPER_LEDGER_HOST=localhost
SUPER_LEDGER_PORT=4901

# ─── Admin API ────────────────────────────────────────────────────────────
# Ports: x902  (do NOT expose in non-local deployments)
APP_USER_ADMIN_URL=http://localhost:2902
APP_PROVIDER_ADMIN_URL=http://localhost:3902
SUPER_ADMIN_URL=http://localhost:4902

# ─── Supporting services ──────────────────────────────────────────────────
SCAN_URL=http://scan.localhost:4000
SV_UI_URL=http://sv.localhost:4000
PQS_URL=http://localhost:5432

# ─── Backend server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (PostgreSQL + Prisma) ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:GKf5jwvtuwPLBXxQ@db.nmfjdvlqdvdwhtovzyvs.supabase.co:5432/postgres"

# ─── JWT (multi-user auth) ────────────────────────────────────────────────
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=7d

# ─── Canton Participant Node (JSON Ledger API) ────────────────────────────
# Set PROVIDER=canton to connect to a real Canton node.
# CANTON_API_URL: Base URL of the Canton JSON Ledger API
#   Local Canton Quickstart: http://localhost:7575
#   App Provider participant: http://localhost:3975
#   Custom deployment: https://your-canton-node.example.com
CANTON_API_URL=http://localhost:7575

# CANTON_API_TOKEN: Bearer token for Canton JSON Ledger API auth
#   shared-secret mode: leave empty (no auth required)
#   oauth2 mode: use a valid JWT from Keycloak
CANTON_API_TOKEN=
