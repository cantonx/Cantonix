// ─── Prisma Schema — Cantonix Validator Hub v5.0 ─────────────────────────
//
// Canton alignment:
//   User.role           → ADMIN | OPERATOR | USER
//   User.partyId        → null until Canton assigns a real Party ID
//   User.onboardingStatus → pending | approved | rejected
//   InvitationCode      → Operator-controlled onboarding authorization
//   OnboardingRequest   → Tracks party creation lifecycle
//   Validator           → Participant Node health snapshot (per-user)
//   SwapTransaction     → CC transfer record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OPERATOR
  USER
}

enum OnboardingStatus {
  pending
  approved
  rejected
}

enum InvitationStatus {
  active
  expired
  revoked
}

enum ValidatorStatus {
  healthy
  degraded
  offline
}

enum ValidatorRole {
  validator
  super_validator
}

enum SwapStatus {
  pending_approval
  completed
  failed
}

// ─── User ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String

  /// RBAC role — controls what actions this user can perform
  role         UserRole @default(USER)

  /// Canton Party ID — null until onboarding is approved
  /// Real format: "alice::1220<fingerprint>"
  /// Mock format: "party-<uuid>"
  partyId      String?  @unique

  /// Canton-style onboarding lifecycle state
  onboardingStatus OnboardingStatus @default(pending)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  invitationCodesCreated InvitationCode[]
  onboardingRequest      OnboardingRequest?
  validators             Validator[]
  swapTransactions       SwapTransaction[]

  @@map("users")
}

// ─── InvitationCode ───────────────────────────────────────────────────────
// Canton concept: Operator-controlled Onboarding Authorization
// Only ADMIN or OPERATOR can create invitation codes.
// Users CANNOT invite other users.

model InvitationCode {
  id            String           @id @default(uuid())
  code          String           @unique
  createdByUserId String

  /// Maximum number of times this code can be used
  maxUses       Int              @default(1)
  /// How many times this code has been used
  usedCount     Int              @default(0)

  status        InvitationStatus @default(active)
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  createdBy     User             @relation(fields: [createdByUserId], references: [id])
  usages        OnboardingRequest[]

  @@index([createdByUserId])
  @@map("invitation_codes")
}

// ─── OnboardingRequest ────────────────────────────────────────────────────

model OnboardingRequest {
  id               String           @id @default(uuid())
  userId           String           @unique
  invitationCodeId String

  status           OnboardingStatus @default(pending)
  partyIdHint      String?
  assignedPartyId  String?
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationCode   InvitationCode   @relation(fields: [invitationCodeId], references: [id])

  @@index([status])
  @@map("onboarding_requests")
}

// ─── Validator (Participant Node snapshot) ────────────────────────────────

model Validator {
  id     String @id @default(uuid())
  userId String

  name   String
  role   ValidatorRole @default(validator)

  status  ValidatorStatus @default(offline)
  version String          @default("unknown")
  uptime  String          @default("0%")
  latency String?

  lastChecked           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  amuletRewards         Float?
  synchronizerConnected Boolean  @default(false)
  participantId         String?
  domainId              String?
  synchronizerStatus    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("validators")
}

// ─── SwapTransaction ──────────────────────────────────────────────────────

model SwapTransaction {
  id            String     @id @default(uuid())
  userId        String
  transactionId String
  status        SwapStatus @default(pending_approval)
  fromToken     String
  toToken       String
  fromAmount    Float
  toAmount      Float
  walletAddress String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("swap_transactions")
}
