// ─── Prisma Schema — Cantonix Validator Hub v4.0 ─────────────────────────
//
// Canton alignment:
//   User.partyId        → null until Canton assigns a real Party ID
//   User.onboardingStatus → pending | approved | rejected
//   InvitationCode      → Canton-style onboarding authorization token
//   OnboardingRequest   → tracks sponsor-based party creation flow
//   Validator           → Participant Node health snapshot (per-user)
//   SwapTransaction     → CC transfer record (maps to Canton ledger updateId)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum OnboardingStatus {
  pending   // User registered, awaiting sponsor approval
  approved  // Sponsor approved — Canton Party created (or simulated)
  rejected  // Sponsor rejected the request
}

enum ValidatorStatus {
  healthy
  degraded
  offline
}

enum ValidatorRole {
  validator
  super_validator
}

enum SwapStatus {
  pending_approval
  completed
  failed
}

// ─── User ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String

  /// Canton Party ID — null until onboarding is approved and Canton assigns it.
  /// Format (real Canton): "alice::1220<fingerprint>"
  /// Format (mock):        "party-<uuid>"
  partyId      String?  @unique

  /// Canton-style onboarding lifecycle state
  onboardingStatus OnboardingStatus @default(pending)

  /// The user who sponsored this account (invited them)
  /// null for the first admin/bootstrap user
  sponsorId    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sponsor              User?              @relation("SponsorRelation", fields: [sponsorId], references: [id])
  sponsoredUsers       User[]             @relation("SponsorRelation")
  invitationCodesIssued InvitationCode[]  @relation("InvitationIssuer")
  onboardingRequest    OnboardingRequest?
  validators           Validator[]
  swapTransactions     SwapTransaction[]

  @@map("users")
}

// ─── InvitationCode ───────────────────────────────────────────────────────
// Canton concept: Onboarding Authorization
// A sponsor (existing participant) issues a one-time code to authorize
// a new party to join the network.

model InvitationCode {
  id        String   @id @default(uuid())
  code      String   @unique  // The actual invitation token (e.g. "CANTON-XXXX-XXXX")
  issuedById String           // The sponsor who created this code

  /// Whether this code has been consumed by a signup
  usedById  String?  @unique  // userId of the person who used it
  usedAt    DateTime?

  expiresAt DateTime?          // Optional expiry
  createdAt DateTime @default(now())

  // Relations
  issuedBy  User     @relation("InvitationIssuer", fields: [issuedById], references: [id])

  @@index([issuedById])
  @@map("invitation_codes")
}

// ─── OnboardingRequest ────────────────────────────────────────────────────
// Canton concept: Party Onboarding Flow
// Tracks the full lifecycle: invited → registered → approved → party created

model OnboardingRequest {
  id     String @id @default(uuid())
  userId String @unique  // The party candidate

  /// The sponsor who must approve this request
  sponsorId String

  /// The invitation code used to initiate this request
  invitationCodeId String

  /// Current status in the onboarding lifecycle
  status OnboardingStatus @default(pending)

  /// Canton Party ID hint — suggested identifier for the new party
  /// Format: lowercase alphanumeric, used as hint in POST /v2/parties
  partyIdHint String?

  /// Canton Party ID assigned after approval
  /// Populated by CantonParticipantProvider.createParty() or mock
  assignedPartyId String?

  /// Notes from the sponsor (approval/rejection reason)
  reviewNote String?

  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("onboarding_requests")
}

// ─── Validator (Participant Node snapshot) ────────────────────────────────

model Validator {
  id     String @id @default(uuid())
  userId String

  /// Display name, e.g. "App User Participant"
  name   String
  /// Canton role: validator | super_validator
  role   ValidatorRole @default(validator)

  status  ValidatorStatus @default(offline)
  version String          @default("unknown")
  uptime  String          @default("0%")
  /// Round-trip latency string, e.g. "120ms" — null when offline
  latency String?

  lastChecked DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// CC (Amulet) rewards — null when offline or unavailable
  amuletRewards         Float?
  synchronizerConnected Boolean @default(false)

  /// Canton Participant Node ID (future: from Admin API)
  participantId String?

  /// Global Synchronizer domain ID this node is connected to
  domainId String?

  /// Synchronizer connectivity status (derived from participant health)
  synchronizerStatus String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("validators")
}

// ─── SwapTransaction ──────────────────────────────────────────────────────

model SwapTransaction {
  id     String @id @default(uuid())
  userId String

  /// Canton ledger updateId or transfer offer tracking_id
  transactionId String
  status        SwapStatus @default(pending_approval)

  fromToken  String
  toToken    String
  fromAmount Float
  toAmount   Float

  /// Canton party ID or wallet address used as sender
  walletAddress String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("swap_transactions")
}
